# Copy this file to .env and fill in any one (or more) free-tier API keys.
# Do NOT commit .env — it is ignored by .gitignore.

# GitHub Models (free with any GitHub account; PAT with models:read)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Google AI Studio (free tier)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (free tier)
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional: if running Ollama on your host machine instead of inside Docker,
# uncomment this override so the container reaches host.docker.internal:11434:
# LLMDAP_OVERRIDE_CHAT_LOCAL={"endpoint":"http://host.docker.internal:11434","dialect":"ollama","model":"llama3.2:3b","auth":{"method":"none"},"governance":{"data_classification":"restricted","zero_data_retention":true,"region":"on-prem"}}

