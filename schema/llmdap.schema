# LLMDAP OpenLDAP Schema (Draft v0.1)
# Note: Replace 1.3.6.1.4.1.99999 with an assigned IANA Private Enterprise Number for production.

objectIdentifier LLMDAPRoot 1.3.6.1.4.1.99999.42
objectIdentifier LLMDAPAttr LLMDAPRoot:1
objectIdentifier LLMDAPObj  LLMDAPRoot:2

# Attributes

attributetype ( LLMDAPAttr:1
    NAME 'llmdapEndpoint'
    DESC 'Inference API base URI'
    EQUALITY caseExactIA5Match
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
    SINGLE-VALUE )

attributetype ( LLMDAPAttr:2
    NAME 'llmdapDialect'
    DESC 'Wire protocol dialect (e.g., openai-chat, anthropic-messages)'
    EQUALITY caseIgnoreIA5Match
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
    SINGLE-VALUE )

attributetype ( LLMDAPAttr:3
    NAME 'llmdapModel'
    DESC 'Provider-specific model identifier'
    EQUALITY caseExactIA5Match
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
    SINGLE-VALUE )

attributetype ( LLMDAPAttr:4
    NAME 'llmdapAuthMethod'
    DESC 'Authentication broker method (none, env, oidc-exchange, secret-store, portal-request)'
    EQUALITY caseIgnoreIA5Match
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
    SINGLE-VALUE )

attributetype ( LLMDAPAttr:5
    NAME 'llmdapAuthLocator'
    DESC 'Credential locator URI, env var name, or onboarding portal URL'
    EQUALITY caseExactIA5Match
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
    SINGLE-VALUE )

attributetype ( LLMDAPAttr:6
    NAME 'llmdapClassification'
    DESC 'Maximum permitted data sensitivity tier (public, internal, confidential, restricted)'
    EQUALITY caseIgnoreIA5Match
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
    SINGLE-VALUE )

attributetype ( LLMDAPAttr:7
    NAME 'llmdapZeroDataRetention'
    DESC 'Boolean indicating contractual zero prompt/response retention'
    EQUALITY booleanMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
    SINGLE-VALUE )

attributetype ( LLMDAPAttr:8
    NAME 'llmdapTTL'
    DESC 'Client cache time-to-live in seconds'
    EQUALITY integerMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
    SINGLE-VALUE )

# ObjectClass

objectclass ( LLMDAPObj:1
    NAME 'llmdapService'
    DESC 'LLMDAP Inference Service Discovery Entry'
    SUP top
    STRUCTURAL
    MUST ( cn $ llmdapEndpoint $ llmdapDialect $ llmdapModel $ llmdapAuthMethod )
    MAY ( llmdapAuthLocator $ llmdapClassification $ llmdapZeroDataRetention $ llmdapTTL $ description ) )

