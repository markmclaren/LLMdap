{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMDAP Directory Document",
  "type": "object",
  "required": ["llmdap_version", "records"],
  "additionalProperties": false,
  "properties": {
    "llmdap_version": { "const": "0.1" },
    "records": {
      "type": "object",
      "description": "Logical service name -> record",
      "additionalProperties": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["endpoint", "dialect", "model", "auth"],
      "additionalProperties": false,
      "properties": {
        "endpoint": { "type": "string", "format": "uri", "description": "Base URL of the inference API" },
        "dialect": {
          "type": "string",
          "description": "Wire protocol: openai-chat, anthropic-messages or ollama (others by agreement)",
          "minLength": 1
        },
        "model": { "type": "string", "minLength": 1 },
        "auth": {
          "type": "object",
          "required": ["method"],
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "description": "none, env or portal-request (others via a client-registered handler)" },
            "locator": { "type": "string", "description": "Env var name or onboarding URL" },
            "header": { "type": "string", "default": "Authorization" },
            "prefix": { "type": "string", "default": "Bearer " }
          },
          "allOf": [
            {
              "if": { "properties": { "method": { "enum": ["env", "portal-request"] } } },
              "then": { "required": ["locator"] }
            }
          ]
        },
        "classification": {
          "enum": ["public", "internal", "confidential", "restricted"],
          "default": "public",
          "description": "Most sensitive data this endpoint is cleared to receive"
        }
      }
    }
  }
}
